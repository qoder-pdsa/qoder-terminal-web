{
  "name": "qoder-terminal-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "tsc -b --noEmit && tsc -p e2e/tsconfig.json",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:api": "playwright test -c e2e/playwright.config.ts --project=api",
    "e2e:ui": "playwright test -c e2e/playwright.config.ts --project=ui"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
